# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Session security (required in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=aK7+v4R7lK9mQ2zP8xW1yN5jT0bC3vF6hJ9kL2mP5rT=

# Instagram / Meta App
# Uses "Instagram API with Instagram Login" — NOT Instagram Basic Display.
# App ID / secret: use the Instagram app ID and secret from the Instagram product page.
NEXT_PUBLIC_INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Optional: parent Meta app secret if webhook signature validation fails with INSTAGRAM_APP_SECRET
META_APP_SECRET=
# Must exactly match an OAuth redirect URI in Instagram Business login settings
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Random string; same value goes in the Meta webhook subscription form
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=choose_a_strong_verify_token

# AI Auto-Reply (optional)
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.1-8b-instant

# Optional internal secrets (legacy scripts)
GATEWAY_SECRET=
API_SECRET_KEY=

# Development only — set to true to skip webhook HMAC validation (never enable in production)
# DISABLE_WEBHOOK_SIGNATURE_CHECK=false
